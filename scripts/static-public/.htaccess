RewriteEngine On

# Одно зеркало для поисковиков: www.hud-service.ru → hud-service.ru (301),
# иначе Яндекс видит два одинаковых сайта.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Старый домен hdkv-ai.ru (та же папка на хостинге) → hud-service.ru, адрес
# в адрес: иначе Яндекс держит два одинаковых сайта и может считать главным
# старый. .well-known не трогаем — по нему продлевается сертификат.
RewriteCond %{HTTP_HOST} ^(www\.)?hdkv-ai\.ru$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://hud-service.ru/$1 [R=301,L]

# Корень сразу ведёт на «Создание контента» серверным 301. В статичной
# версии redirect() из page.tsx срабатывает только в браузере, а робот
# видел на главной пустую страницу-ошибку.
RewriteRule ^$ /content/ [R=301,L]

RewriteRule ^portfolio/?$ /#works [R=302,NE,L]
ErrorDocument 404 /404.html

# Страницы — всегда свежие, файлы сборки — надолго (2026-10-08). Без этого
# Safari держал старую страницу в памяти, а её файлы стилей после выкладки
# уже удалены — сайт открывался голым текстом.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
